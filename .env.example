# =============================================================================
# E-Commerce Customer 360 Lakehouse - Environment Variables
#
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# All defaults are local (no cloud services). Never commit .env.
# =============================================================================

# --- MinIO (S3-compatible object storage) ------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# MinIO buckets (created by scripts/bootstrap_minio.py)
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# --- Postgres (Hive Metastore backend) ------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive
POSTGRES_DB=hive

# --- Hive Metastore ---------------------------------------------------------------
HIVE_METASTORE_URI=thrift://localhost:9083

# --- Trino ----------------------------------------------------------------------------
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=admin
TRINO_CATALOG=iceberg
TRINO_SCHEMA=bronze

# --- Synthetic data generator ----------------------------------------------------------
DATA_SEED=42
DATA_DATE_START=2024-01-01
DATA_DATE_END=2024-12-31
DATA_NUM_CUSTOMERS=5000
DATA_NUM_ORDERS=50000

# --- Dagster ----------------------------------------------------------------------------
# Uncomment to pin DAGSTER_HOME (defaults to dagster_project/)
# DAGSTER_HOME=./dagster_project

# --- Streamlit dashboard --------------------------------------------------------
# Runs in the local venv (not Docker); queries Trino live.
STREAMLIT_HOST=localhost
STREAMLIT_PORT=8501
