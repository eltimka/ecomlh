# =============================================================================
# E-Commerce Customer 360 Lakehouse - Environment Variables
#
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# All defaults are local (no cloud services). Never commit .env.
# =============================================================================

# --- Garage (S3-compatible object storage) -----------------------------------
GARAGE_ENDPOINT=localhost:3900
GARAGE_ACCESS_KEY=garageadmin
GARAGE_SECRET_KEY=garageadmin-local-dev-secret
GARAGE_USE_SSL=false
GARAGE_REGION=garage

# Garage buckets (created by scripts/bootstrap_storage.py; bronze is
# pre-created by the garage service via --default-bucket)
GARAGE_BUCKET_BRONZE=bronze
GARAGE_BUCKET_SILVER=silver
GARAGE_BUCKET_GOLD=gold
GARAGE_BUCKET_FLINK=flink-state

# --- Postgres (Hive Metastore backend) ------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive
POSTGRES_DB=hive

# --- Hive Metastore ---------------------------------------------------------------
HIVE_METASTORE_URI=thrift://localhost:9083

# --- Trino ----------------------------------------------------------------------------
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=admin
TRINO_CATALOG=iceberg
TRINO_SCHEMA=bronze

# --- Synthetic data generator ----------------------------------------------------------
DATA_SEED=42
DATA_DATE_START=2024-01-01
DATA_DATE_END=2024-12-31
DATA_NUM_CUSTOMERS=5000
DATA_NUM_ORDERS=50000

# --- Kafka (streaming bus, Phase 11+) ------------------------------------------------
# Host clients use the PLAINTEXT listener; container clients (Flink, Phase 12+)
# use kafka:9094 (the INTERNAL listener).
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=raw.web_events
STREAM_LIVE_RATE=20
# Tolerance (rows) for the consumer_lag check: committed stream rows vs the
# topic end offset. The check is non-blocking - it signals stream health.
STREAM_LAG_TOLERANCE=1000

# --- Dagster ----------------------------------------------------------------------------
# Uncomment to pin DAGSTER_HOME (defaults to dagster_project/)
# DAGSTER_HOME=./dagster_project

# --- Streamlit dashboard --------------------------------------------------------
# Runs in the local venv (not Docker); queries Trino live.
STREAMLIT_HOST=localhost
STREAMLIT_PORT=8501
