[
  {
    "name": "kpi_customers",
    "title": "Total Customers",
    "viz_type": "BIG_NUMBER",
    "dataset": "kpi_customers",
    "metrics": [{ "sql": "MAX(value)", "label": "customers" }]
  },
  {
    "name": "kpi_orders",
    "title": "Total Orders",
    "viz_type": "BIG_NUMBER",
    "dataset": "kpi_orders",
    "metrics": [{ "sql": "MAX(value)", "label": "orders" }]
  },
  {
    "name": "kpi_gmv",
    "title": "Gross Revenue",
    "viz_type": "BIG_NUMBER",
    "dataset": "kpi_gmv",
    "metrics": [{ "sql": "MAX(value)", "label": "gross_revenue" }]
  },
  {
    "name": "kpi_aov",
    "title": "Avg Order Value (net)",
    "viz_type": "BIG_NUMBER",
    "dataset": "kpi_aov",
    "metrics": [{ "sql": "MAX(value)", "label": "aov" }]
  },
  {
    "name": "ltv_distribution",
    "title": "LTV Distribution (net revenue per customer)",
    "viz_type": "BAR",
    "dataset": "ltv_distribution",
    "groupby": ["ltv_bucket"],
    "metrics": [{ "sql": "SUM(customers)", "label": "customers" }],
    "orderby": [["ltv_bucket", "asc"]]
  },
  {
    "name": "churn_risk_mix",
    "title": "Churn Risk Mix",
    "viz_type": "PIE",
    "dataset": "churn_risk_mix",
    "groupby": ["churn_risk"],
    "metrics": [{ "sql": "SUM(customers)", "label": "customers" }]
  },
  {
    "name": "rfm_segment_mix",
    "title": "RFM Segments",
    "viz_type": "BAR",
    "dataset": "rfm_segment_mix",
    "groupby": ["rfm_segment"],
    "metrics": [{ "sql": "SUM(customers)", "label": "customers" }],
    "orderby": [["rfm_segment", "asc"]]
  },
  {
    "name": "revenue_trend",
    "title": "Revenue Trend (monthly, gross vs net)",
    "viz_type": "LINE",
    "dataset": "revenue_trend",
    "groupby": ["month"],
    "metrics": [
      { "sql": "SUM(gross_revenue)", "label": "gross_revenue" },
      { "sql": "SUM(net_revenue)", "label": "net_revenue" }
    ],
    "orderby": [["month", "asc"]]
  },
  {
    "name": "channel_mix",
    "title": "Net Revenue by Channel",
    "viz_type": "BAR",
    "dataset": "channel_mix",
    "groupby": ["channel"],
    "metrics": [{ "sql": "SUM(net_revenue)", "label": "net_revenue" }],
    "orderby": [["channel", "asc"]]
  },
  {
    "name": "category_mix",
    "title": "Gross Revenue by Category",
    "viz_type": "BAR",
    "dataset": "category_mix",
    "groupby": ["category"],
    "metrics": [{ "sql": "SUM(gross_revenue)", "label": "gross_revenue" }],
    "orderby": [["category", "asc"]]
  }
]
