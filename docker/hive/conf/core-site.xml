<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
  <!--
    Hadoop FileSystem configuration for the Hive Metastore process.

    WHY THIS FILE EXISTS:
    Hive 4's metastore validates table locations at CREATE TABLE time
    (HMSHandler.create_table_core -> Warehouse.isDir -> Path.getFileSystem).
    For s3a:// locations it instantiates org.apache.hadoop.fs.s3a.S3AFileSystem,
    which requires:
      1. hadoop-aws + aws-java-sdk-bundle on the HMS classpath
         (staged by the hive-aws-init one-shot service into /opt/hive/auxjars,
         added via HIVE_AUX_JARS_PATH in docker-compose.yml)
      2. The fs.s3a.* properties below, pointing at Garage.
    Without both, Iceberg table creation fails with:
      "ClassNotFoundException: Class org.apache.hadoop.fs.s3a.S3AFileSystem not found"

    Local-dev credentials only - same as the garage service in ../docker-compose.yml.
  -->

  <property>
    <name>fs.s3a.impl</name>
    <value>org.apache.hadoop.fs.s3a.S3AFileSystem</value>
  </property>
  <property>
    <name>fs.s3a.endpoint</name>
    <value>http://garage:3900</value>
  </property>
  <property>
    <name>fs.s3a.access.key</name>
    <value>garageadmin</value>
  </property>
  <property>
    <name>fs.s3a.secret.key</name>
    <value>garageadmin-local-dev-secret</value>
  </property>
  <property>
    <name>fs.s3a.path.style.access</name>
    <value>true</value>
  </property>
  <!-- Garage validates the SigV4 credential scope against its s3_region.
       S3A defaults to us-east-1, which Garage rejects (400 Bad Request);
       this property overrides the signing region to match garage.toml. -->
  <property>
    <name>fs.s3a.endpoint.region</name>
    <value>garage</value>
  </property>
  <property>
    <name>fs.s3a.connection.maximum</name>
    <value>20</value>
  </property>
</configuration>
